<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<% metadata = site.metadata %>
<% page_title = resource.data.title.to_s.empty? ? "#{metadata.title}: #{metadata.tagline}" : "#{resource.data.title} | #{metadata.title}" %>
<% description = resource.data.description || metadata.description %>
<% canonical = absolute_url(resource.relative_url) %>
<% og_image = absolute_url(resource.data.og_image || "/og/home.png") %>
<title><%= page_title %></title>
<meta name="description" content="<%= description %>">
<link rel="canonical" href="<%= canonical %>">
<link rel="alternate" type="application/atom+xml" title="<%= metadata.title %>" href="<%= absolute_url "/feed.xml" %>">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="stylesheet" href="/css/site.css">
<meta property="og:site_name" content="<%= metadata.title %>">
<meta property="og:title" content="<%= resource.data.title || metadata.title %>">
<meta property="og:description" content="<%= description %>">
<meta property="og:url" content="<%= canonical %>">
<meta property="og:image" content="<%= og_image %>">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta name="twitter:card" content="summary_large_image">
<% if resource.collection.label == "posts" %>
<meta property="og:type" content="article">
<meta property="article:published_time" content="<%= resource.date.iso8601 %>">
<% else %>
<meta property="og:type" content="website">
<% end %>
<% if resource.data.noindex %>
<meta name="robots" content="noindex, nofollow">
<% end %>
<%= render "analytics" %>
<%= live_reload_dev_js %>
