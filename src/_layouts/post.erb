---
layout: default
---

<article class="prose post">
  <header class="post-header">
    <h1><%= data.title %></h1>
    <p class="post-meta">
      <time datetime="<%= resource.date.iso8601 %>"><%= resource.date.strftime("%B %-d, %Y") %></time>
      <% Array(data.tags).each do |tag| %><span class="tag"><%= tag %></span><% end %>
    </p>
  </header>
  <%= yield %>
</article>
<%= render "subscribe", source: resource.data.slug %>
